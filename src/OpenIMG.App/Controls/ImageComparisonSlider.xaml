<UserControl x:Class="OpenIMG.App.Controls.ImageComparisonSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             SizeChanged="OnSizeChanged"
             PreviewMouseWheel="OnPreviewMouseWheel"
             PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
             PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp"
             PreviewMouseMove="OnPreviewMouseMove"
             MouseDoubleClick="OnMouseDoubleClick">
    <UserControl.Resources>
        <Style x:Key="ViewerToolButton" TargetType="Button">
            <Setter Property="Background" Value="#202632" />
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="BorderBrush" Value="#3A4352" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#303A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#151A22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#090B10" ClipToBounds="True">
        <Image x:Name="BeforeImage"
               Source="{Binding OriginalImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BeforeScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BeforeTranslate" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Grid x:Name="AfterContainer">
            <Grid.Clip>
                <RectangleGeometry x:Name="ClipGeometry" />
            </Grid.Clip>
            <Image x:Name="AfterImage"
                   Source="{Binding RestoredImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AfterScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="AfterTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <Canvas x:Name="DividerCanvas">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RestoredImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OriginalImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Line x:Name="DividerLine"
                  Y1="0" Y2="600"
                  Stroke="#F8FAFC" StrokeThickness="2"
                  IsHitTestVisible="False" />
            <Border x:Name="HandleThumb"
                    Width="38" Height="38"
                    CornerRadius="19"
                    Background="#1769E0"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    Cursor="SizeWE"
                    MouseLeftButtonDown="OnThumbMouseDown"
                    MouseLeftButtonUp="OnThumbMouseUp"
                    MouseMove="OnThumbMouseMove">
                <TextBlock Text="↔" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" FontWeight="Bold" />
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#D9161B23" BorderBrush="#455061" BorderThickness="1"
                CornerRadius="6" Margin="16" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="ORIGINAL" Foreground="#E7EBF2" FontSize="10" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#D9161B23" BorderBrush="#455061" BorderThickness="1"
                CornerRadius="6" Margin="16" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="RESULTADO GPT" Foreground="#E7EBF2" FontSize="10" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#E51A202B" BorderBrush="#3A4352" BorderThickness="1"
                CornerRadius="9" Margin="12" Padding="7">
            <StackPanel Orientation="Horizontal">
                <Button Content="−" Style="{StaticResource ViewerToolButton}" Padding="10,5"
                        ToolTip="Alejar" Click="OnZoomOutClicked" />
                <TextBlock x:Name="ZoomHint" Text="100%" MinWidth="54"
                           Foreground="#F3F4F6" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                <Button Content="+" Style="{StaticResource ViewerToolButton}" Padding="10,5"
                        ToolTip="Acercar" Click="OnZoomInClicked" />
                <Border Width="1" Background="#3A4352" Margin="8,4" />
                <Button Content="Ajustar" Style="{StaticResource ViewerToolButton}" Padding="10,5"
                        ToolTip="Ajustar imagen al visor" Click="OnFitClicked" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#E51A202B" BorderBrush="#3A4352" BorderThickness="1"
                CornerRadius="8" Margin="12,12,12,70" Padding="12,9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RestoredImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="RESULTADO GPT PENDIENTE" Foreground="#FBBF24"
                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding RestoredStatusText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                           Foreground="#D7DCE5" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="420" TextAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F010141C" BorderBrush="#3A4352" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OriginalImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="◫" FontSize="30" Foreground="#60A5FA" HorizontalAlignment="Center" />
                <TextBlock Text="Foto original no disponible" Foreground="#F3F4F6"
                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,3" />
                <TextBlock Text="{Binding OriginalStatusText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                           Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
